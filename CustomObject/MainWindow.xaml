<Window x:Class="Vitrine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:custom="clr-namespace:CustomObjectWPF.Model"
        mc:Ignorable="d"
        Title="Vitrine CustomObjectWPF — v15" Width="1020" Height="860"
        Background="#FF1E1E1E" Foreground="#FFEDEDED">
    <Window.Resources>
        <!-- Carte d'un exemple (nom de la propriété + explication + contrôle) -->
        <Style x:Key="CarteExemple" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D2D" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#FF404040" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="TitrePropriete" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF00D1FF" />
        </Style>
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFCCCCCC" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <!-- Titre + description d'une page -->
        <Style x:Key="TitrePage" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="DescriptionPage" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FFBBBBBB" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,16" />
        </Style>
        <!-- Carte cliquable de l'accueil -->
        <Style x:Key="CarteAccueil" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D2D" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#FF404040" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Barre latérale ============ -->
        <Border Grid.Column="0" Background="#FF232323" BorderBrush="#FF333333" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <TextBlock Text="CustomObjectWPF" FontSize="20" FontWeight="Bold" Foreground="#FF00D1FF" />
                <TextBlock Text="v13 — 12 contrôles" FontSize="12" Foreground="#FFAAAAAA" Margin="0,2,0,0" />
                <custom:SearchBoxCustom x:Name="navSearch" Watermark="Rechercher un contrôle..." CornerRadius="8" Height="38" FontSize="14" Margin="0,14,0,10" />
                <custom:ListBoxCustom x:Name="navList" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="White"
                                      SelectedItemBackground="#FF00D1FF" SelectedItemForeground="Black"
                                      CornerRadius="8" ItemCornerRadius="6" />
                <TextBlock Text="Clique un contrôle pour voir ses exemples. La recherche filtre la liste." FontSize="11" Foreground="#FF888888" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <!-- ============ Contenu ============ -->
        <ScrollViewer Grid.Column="1" x:Name="contentScroll" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">

                <!-- ===== Accueil ===== -->
                <StackPanel x:Name="page_Accueil">
                    <TextBlock Text="Tous les contrôles" Style="{StaticResource TitrePage}" />
                    <TextBlock Text="12 contrôles custom, prêts à copier dans ton projet. Clique une carte pour voir les exemples d'un contrôle — chaque exemple montre une propriété et ce qu'elle fait." Style="{StaticResource DescriptionPage}" />
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource CarteAccueil}" Tag="ButtonCustom" MouseLeftButtonUp="HomeCard_Click">
                            <StackPanel>
                                <TextBlock Text="ButtonCustom" FontSize="15" FontWeight="Bold" Foreground="#FF00D1FF" />
                                <TextBlock Text="Bouton avec coins arrondis, survol, néon." FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CarteAccueil}" Tag="CheckBoxCustom" MouseLeftButtonUp="HomeCard_Click">
                            <StackPanel>
                                <TextBlock Text="CheckBoxCustom" FontSize="15" FontWeight="Bold" Foreground="#FF00D1FF" />
                                <TextBlock Text="Case à cocher stylée, coche colorée, néon." FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CarteAccueil}" Tag="ToggleSwitchCustom" MouseLeftButtonUp="HomeCard_Click">
                            <StackPanel>
                                <TextBlock Text="ToggleSwitchCustom" FontSize="15" FontWeight="Bold" Foreground="#FF00D1FF" />
                                <TextBlock Text="Interrupteur on/off avec couleurs perso." FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CarteAccueil}" Tag="CardCustom" MouseLeftButtonUp="HomeCard_Click">
                            <StackPanel>
                                <TextBlock Text="CardCustom" FontSize="15" FontWeight="Bold" Foreground="#FF00D1FF" />
                                <TextBlock Text="Carte avec titre, contenu et néon." FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CarteAccueil}" Tag="SliderCustom" MouseLeftButtonUp="HomeCard_Click">
                            <StackPanel>
                                <TextBlock Text="SliderCustom" FontSize="15" FontWeight="Bold" Foreground="#FF00D1FF" />
                                <TextBlock Text="Curseur avec piste et pastille colorées." FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CarteAccueil}" Tag="ListBoxCustom" MouseLeftButtonUp="HomeCard_Click">
                            <StackPanel>
                                <TextBlock Text="ListBoxCustom" FontSize="15" FontWeight="Bold" Foreground="#FF00D1FF" />
                                <TextBlock Text="Liste avec sélection stylée, même des cartes." FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CarteAccueil}" Tag="TextBoxCustom" MouseLeftButtonUp="HomeCard_Click">
                            <StackPanel>
                                <TextBlock Text="TextBoxCustom" FontSize="15" FontWeight="Bold" Foreground="#FF00D1FF" />
                                <TextBlock Text="Champ texte avec Watermark et néon." FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CarteAccueil}" Tag="PasswordBoxCustom" MouseLeftButtonUp="HomeCard_Click">
                            <StackPanel>
                                <TextBlock Text="PasswordBoxCustom" FontSize="15" FontWeight="Bold" Foreground="#FF00D1FF" />
                                <TextBlock Text="Mot de passe classique, bindable." FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CarteAccueil}" Tag="PasswordRevealCustom" MouseLeftButtonUp="HomeCard_Click">
                            <StackPanel>
                                <TextBlock Text="PasswordRevealCustom" FontSize="15" FontWeight="Bold" Foreground="#FF00D1FF" />
                                <TextBlock Text="Mot de passe + œil pour révéler." FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CarteAccueil}" Tag="SearchBoxCustom" MouseLeftButtonUp="HomeCard_Click">
                            <StackPanel>
                                <TextBlock Text="SearchBoxCustom" FontSize="15" FontWeight="Bold" Foreground="#FF00D1FF" />
                                <TextBlock Text="Recherche avec loupe, X et Watermark." FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CarteAccueil}" Tag="NumericUpDownCustom" MouseLeftButtonUp="HomeCard_Click">
                            <StackPanel>
                                <TextBlock Text="NumericUpDownCustom" FontSize="15" FontWeight="Bold" Foreground="#FF00D1FF" />
                                <TextBlock Text="Nombre avec boutons +/− et molette." FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CarteAccueil}" Tag="ComboBoxCustom" MouseLeftButtonUp="HomeCard_Click">
                            <StackPanel>
                                <TextBlock Text="ComboBoxCustom" FontSize="15" FontWeight="Bold" Foreground="#FF00D1FF" />
                                <TextBlock Text="Liste déroulante avec Placeholder." FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Text="Librairie v15 — copie CustomObjectWPF.cs dans ton projet, ajoute xmlns:custom=&quot;clr-namespace:CustomObjectWPF.Model&quot; et c'est prêt." FontSize="12" Foreground="#FF888888" TextWrapping="Wrap" Margin="6,10,6,0" />
                </StackPanel>

                <!-- ===== ButtonCustom ===== -->
                <StackPanel x:Name="page_ButtonCustom" Visibility="Collapsed">
                    <TextBlock Text="ButtonCustom" Style="{StaticResource TitrePage}" />
                    <TextBlock Text="Un bouton comme celui de WPF, avec des coins arrondis et des couleurs au survol et au clic. Une carte = une propriété." Style="{StaticResource DescriptionPage}" />
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="Par défaut" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Le bouton tel quel, sans rien changer." Style="{StaticResource Description}" />
                            <custom:ButtonCustom Content="Cliquer" Width="140" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="CornerRadius" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Arrondit les coins du bouton. 0 = coins vifs, 20 = très rond." Style="{StaticResource Description}" />
                            <custom:ButtonCustom Content="Très rond" Width="140" Height="42" FontSize="16" CornerRadius="20" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="HoverBackground" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Couleur du fond quand la souris passe dessus. Essaie : passe la souris sur le bouton." Style="{StaticResource Description}" />
                            <custom:ButtonCustom Content="Survole-moi" Width="140" Height="42" FontSize="16" Background="#FF2D2D2D" Foreground="White" HoverBackground="DarkBlue" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="PressedBackground" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Couleur du fond pendant qu'on tient le clic. Essaie : maintiens le clic sur le bouton." Style="{StaticResource Description}" />
                            <custom:ButtonCustom Content="Tiens le clic" Width="140" Height="42" FontSize="16" Background="#FF2D2D2D" Foreground="White" PressedBackground="DarkRed" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="Neon" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Ajoute une lueur autour du bouton. La lueur est derrière le texte, donc le texte reste net." Style="{StaticResource Description}" />
                            <custom:ButtonCustom Content="Néon" Width="140" Height="42" FontSize="16" Background="#FF2D2D2D" Foreground="White" Neon="True" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="NeonColor" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la couleur de la lueur. Ici, magenta." Style="{StaticResource Description}" />
                            <custom:ButtonCustom Content="Néon magenta" Width="160" Height="42" FontSize="16" Background="#FF2D2D2D" Foreground="White" Neon="True" NeonColor="Magenta" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="NeonRadius" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la taille de la lueur (le flou, en px). Ici, 40 : une grosse lueur. Défaut : 20." Style="{StaticResource Description}" />
                            <custom:ButtonCustom Content="Grosse lueur" Width="160" Height="42" FontSize="16" Background="#FF2D2D2D" Foreground="White" Neon="True" NeonRadius="40" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="IsEnabled = False" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Bouton désactivé : il devient pâle et ne clique plus. C'est une propriété de base de WPF, pas une propriété custom." Style="{StaticResource Description}" />
                            <custom:ButtonCustom Content="Désactivé" Width="140" Height="42" FontSize="16" IsEnabled="False" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="Icon (nouveau v15)" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Une image à gauche du texte : un bouton avec icône. L'image se met dans Icon (ta propre image, ou une image intégrée). Sans Icon, le bouton est normal, rien ne change." Style="{StaticResource Description}" />
                            <custom:ButtonCustom x:Name="btnIconDemo" Content="Rechercher" Width="200" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="IconWidth" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="La taille de l'icône, en largeur et en hauteur (carrée). Ici, 32 : une grosse icône. Défaut : 20." Style="{StaticResource Description}" />
                            <custom:ButtonCustom x:Name="btnIconDemo2" Content="Gros icône" Width="220" Height="48" FontSize="16" IconWidth="32" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="IconSpacing" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="L'espacement entre l'icône et le texte. Ici, 20 : bien aéré. Défaut : 8." Style="{StaticResource Description}" />
                            <custom:ButtonCustom x:Name="btnIconDemo3" Content="Espacé" Width="220" Height="42" FontSize="16" IconSpacing="20" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== CheckBoxCustom ===== -->
                <StackPanel x:Name="page_CheckBoxCustom" Visibility="Collapsed">
                    <TextBlock Text="CheckBoxCustom" Style="{StaticResource TitrePage}" />
                    <TextBlock Text="Une case à cocher comme celle de WPF, mais stylée. Une carte = une propriété." Style="{StaticResource DescriptionPage}" />
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="Par défaut" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="La case telle quelle, décochée. Clique dessus pour cocher." Style="{StaticResource Description}" />
                            <custom:CheckBoxCustom Content="Se souvenir de moi" FontSize="16" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="IsChecked" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Coche la case dès le départ. C'est une propriété de base de WPF." Style="{StaticResource Description}" />
                            <custom:CheckBoxCustom Content="Déjà cochée" FontSize="16" Foreground="White" IsChecked="True" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="CheckColor" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la couleur du crochet. Ici, vert." Style="{StaticResource Description}" />
                            <custom:CheckBoxCustom Content="Coche verte" FontSize="16" Foreground="White" IsChecked="True" CheckColor="Green" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="BoxSize" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la taille de la case (en px). Ici, 28 : une grosse case. Le crochet s'adapte tout seul." Style="{StaticResource Description}" />
                            <custom:CheckBoxCustom Content="Grosse case" FontSize="16" Foreground="White" IsChecked="True" BoxSize="28" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="BoxSpacing" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change l'espace entre la case et le texte (en px). Ici, 20 : un grand espace." Style="{StaticResource Description}" />
                            <custom:CheckBoxCustom Content="Grand espace" FontSize="16" Foreground="White" IsChecked="True" BoxSpacing="20" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="BorderHover" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Couleur de la bordure de la case quand la souris passe dessus. Essaie : survole la case, elle devient rouge." Style="{StaticResource Description}" />
                            <custom:CheckBoxCustom Content="Survole la case" FontSize="16" Foreground="White" IsChecked="True" BorderHover="Red" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="CornerRadius" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Arrondit les coins de la case. Ici, 10 : une case bien ronde." Style="{StaticResource Description}" />
                            <custom:CheckBoxCustom Content="Case ronde" FontSize="16" Foreground="White" IsChecked="True" CornerRadius="10" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="Neon" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Ajoute une lueur autour de la case." Style="{StaticResource Description}" />
                            <custom:CheckBoxCustom Content="Néon" FontSize="16" Foreground="White" IsChecked="True" Neon="True" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="NeonColor" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la couleur de la lueur. Ici, magenta." Style="{StaticResource Description}" />
                            <custom:CheckBoxCustom Content="Néon magenta" FontSize="16" Foreground="White" IsChecked="True" Neon="True" NeonColor="Magenta" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="NeonRadius" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la taille de la lueur. Ici, 30 : une grosse lueur. Défaut : 20." Style="{StaticResource Description}" />
                            <custom:CheckBoxCustom Content="Grosse lueur" FontSize="16" Foreground="White" IsChecked="True" Neon="True" NeonRadius="30" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== ToggleSwitchCustom ===== -->
                <StackPanel x:Name="page_ToggleSwitchCustom" Visibility="Collapsed">
                    <TextBlock Text="ToggleSwitchCustom" Style="{StaticResource TitrePage}" />
                    <TextBlock Text="Un interrupteur on/off, comme sur un téléphone. Une carte = une propriété." Style="{StaticResource DescriptionPage}" />
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="Éteint (par défaut)" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="L'interrupteur tel quel, éteint. Clique dessus pour l'allumer." Style="{StaticResource Description}" />
                            <custom:ToggleSwitchCustom FontSize="16" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="IsChecked" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Allume l'interrupteur dès le départ. C'est une propriété de base de WPF." Style="{StaticResource Description}" />
                            <custom:ToggleSwitchCustom FontSize="16" Foreground="White" IsChecked="True" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="OnBrush" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Couleur du fond quand l'interrupteur est allumé. Ici, vert." Style="{StaticResource Description}" />
                            <custom:ToggleSwitchCustom FontSize="16" Foreground="White" IsChecked="True" OnBrush="Green" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="OffBrush" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Couleur du fond quand l'interrupteur est éteint. Ici, rouge." Style="{StaticResource Description}" />
                            <custom:ToggleSwitchCustom FontSize="16" Foreground="White" OffBrush="Red" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="ThumbBrush" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Couleur de la pastille (le cercle qui glisse). Ici, jaune." Style="{StaticResource Description}" />
                            <custom:ToggleSwitchCustom FontSize="16" Foreground="White" IsChecked="True" ThumbBrush="Yellow" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="Neon" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Ajoute une lueur autour de l'interrupteur." Style="{StaticResource Description}" />
                            <custom:ToggleSwitchCustom FontSize="16" Foreground="White" IsChecked="True" Neon="True" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="NeonColor" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la couleur de la lueur. Ici, magenta." Style="{StaticResource Description}" />
                            <custom:ToggleSwitchCustom FontSize="16" Foreground="White" IsChecked="True" Neon="True" NeonColor="Magenta" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="NeonRadius" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la taille de la lueur. Ici, 30 : une grosse lueur. Défaut : 20." Style="{StaticResource Description}" />
                            <custom:ToggleSwitchCustom FontSize="16" Foreground="White" IsChecked="True" Neon="True" NeonRadius="30" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== CardCustom ===== -->
                <StackPanel x:Name="page_CardCustom" Visibility="Collapsed">
                    <TextBlock Text="CardCustom" Style="{StaticResource TitrePage}" />
                    <TextBlock Text="Une carte : un panneau avec un titre et du contenu dedans. Une carte = une propriété." Style="{StaticResource DescriptionPage}" />
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="Title" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Le titre écrit en haut de la carte. Le contenu va en dessous." Style="{StaticResource Description}" />
                            <custom:CardCustom Title="Mon titre" Background="#FF404040" TitleForeground="White" CornerRadius="10" Width="320">
                                <TextBlock Text="Ceci est le contenu de la carte." Foreground="#FFCCCCCC" TextWrapping="Wrap" />
                            </custom:CardCustom>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="TitleFontSize" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la taille du titre (en px). Ici, 22 : un gros titre." Style="{StaticResource Description}" />
                            <custom:CardCustom Title="Gros titre" TitleFontSize="22" Background="#FF404040" TitleForeground="White" CornerRadius="10" Width="320">
                                <TextBlock Text="Le titre est plus gros que d'habitude." Foreground="#FFCCCCCC" TextWrapping="Wrap" />
                            </custom:CardCustom>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="TitleForeground" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la couleur du titre. Ici, vert." Style="{StaticResource Description}" />
                            <custom:CardCustom Title="Titre vert" TitleForeground="Green" Background="#FF404040" CornerRadius="10" Width="320">

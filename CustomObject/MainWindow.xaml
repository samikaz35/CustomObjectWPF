                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="Format = 2 décimales" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="« 0.00 » force 2 décimales : 2,5 s'affiche « 2,50 ». Pratique pour un poids, une moyenne, une mesure." Style="{StaticResource Description}" />
                            <custom:NumericUpDownCustom Value="2.5" Minimum="0" Maximum="10" Increment="0.1" Format="0.00" Width="320" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== ComboBoxCustom ===== -->
                <StackPanel x:Name="page_ComboBoxCustom" Visibility="Collapsed">
                    <TextBlock Text="ComboBoxCustom" Style="{StaticResource TitrePage}" />
                    <TextBlock Text="Une liste déroulante : on clique, la liste s'ouvre, on choisit. Une carte = une propriété." Style="{StaticResource DescriptionPage}" />
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="ItemsSource" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="La liste des choix. Ici, 4 choix, et « Code » est déjà choisi. La liste vient du code (voir MainWindow.xaml.cs)." Style="{StaticResource Description}" />
                            <custom:ComboBoxCustom x:Name="comboDemo1" SelectedItem="Code" Width="320" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="Placeholder" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Texte affiché quand rien n'est choisi. Ici, « Choisir une catégorie... »." Style="{StaticResource Description}" />
                            <custom:ComboBoxCustom x:Name="comboDemo2" Placeholder="Choisir une catégorie..." Width="320" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="PlaceholderColor" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la couleur du texte Placeholder. Ici, rouge." Style="{StaticResource Description}" />
                            <custom:ComboBoxCustom x:Name="comboDemo5" Placeholder="Choisir..." PlaceholderColor="Red" Width="320" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="DisplayMemberPath" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Quand la liste contient des objets (pas juste du texte), dit quelle propriété afficher. Ici, des objets Categorie, on affiche leur Nom." Style="{StaticResource Description}" />
                            <custom:ComboBoxCustom x:Name="comboDemo3" DisplayMemberPath="Nom" Placeholder="Choisir une catégorie..." Width="320" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="MaxDropDownHeight" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Hauteur maximum de la liste déroulante (en px). Ici, 100 : la liste est courte et on défile dedans. Essaie : clique, la liste a 12 choix mais n'affiche que 100 px de haut." Style="{StaticResource Description}" />
                            <custom:ComboBoxCustom x:Name="comboDemo6" MaxDropDownHeight="100" Placeholder="Choisir un document..." Width="320" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="IsDropDownOpen" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Ouvre la liste dès le départ (vrai) ou la ferme (faux, défaut). Ici, vrai : la liste est déjà ouverte quand la page s'affiche." Style="{StaticResource Description}" />
                            <custom:ComboBoxCustom x:Name="comboDemo7" IsDropDownOpen="True" Width="320" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="CornerRadius" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Arrondit les coins du champ et de la liste. Ici, 20 : un champ très rond." Style="{StaticResource Description}" />
                            <custom:ComboBoxCustom x:Name="comboDemo4" CornerRadius="20" Placeholder="Choisir..." Width="320" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="FocusedBorderBrush" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Couleur de la bordure quand le champ a le focus (quand on clique dedans). Ici, bleu foncé. La bordure a été épaissie à 3 pour l'exemple, pour bien la voir." Style="{StaticResource Description}" />
                            <custom:ComboBoxCustom x:Name="comboDemo8" FocusedBorderBrush="DarkBlue" BorderThickness="3" Placeholder="Choisir..." Width="320" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="Neon" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Ajoute une lueur autour du champ." Style="{StaticResource Description}" />
                            <custom:ComboBoxCustom x:Name="comboDemo9" Neon="True" Placeholder="Choisir..." Width="320" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="NeonColor" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la couleur de la lueur. Ici, magenta." Style="{StaticResource Description}" />
                            <custom:ComboBoxCustom x:Name="comboDemo10" Neon="True" NeonColor="Magenta" Placeholder="Choisir..." Width="320" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CarteExemple}">
                        <StackPanel>
                            <TextBlock Text="NeonRadius" Style="{StaticResource TitrePropriete}" />
                            <TextBlock Text="Change la taille de la lueur. Ici, 30 : une grosse lueur. Défaut : 20." Style="{StaticResource Description}" />
                            <custom:ComboBoxCustom x:Name="comboDemo11" Neon="True" NeonRadius="30" Placeholder="Choisir..." Width="320" Height="42" FontSize="16" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
